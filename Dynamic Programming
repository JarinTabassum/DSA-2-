//Fibonacci number (Memoization / Top-down)
#include<iostream>
#include<vector>
using namespace std;
int Fib(int n,vector<int>& F){
    if(n==0 || n==1){ //base case: these are the stopping conditions for recusrsive calls or else we will fall into a infinity loop
        return n;
    }
    if(F[n-1]==-1){ //suppose we want to find fibonacci of 4th postion,then F[3]==-1 so we will go to Fib(3) and F[2]==-1 so will go to Fib(2) and F[2-1]=Fib(1,F) and when n=1 return 1, F[2-2]=Fib(0,F) and n=0 return 0
        F[n-1]=Fib(n-1,F);
    }
    if(F[n-2]==-1){
        F[n-2]=Fib(n-2,F);
    }
    return F[n-1]+F[n-2];
}
int main(){
    int n;
    cout<<"Enter the position of the fibonacci you want to know:";
    cin>>n;
    vector<int> F(n+1,-1); //as it starts from 0 thats why from 0 to n = n+1 and all of them are set to NIL(-1)
    F[0]=0; 
    F[1]=1; //base case (these base cases arent really necessary as the code will run the same without it but we need it avoid edge cases or excessive recusive calls, it will also come in handy if we want to print the entire fibonacci list upto n)
    int result=Fib(n,F);
    cout<<"The fibonacci at position "<<n<<" is: "<<result;
}

//Top-Down means we start from the original problem (Fib(n)) and break it down into smaller subproblems recursively.
Memoization is used to store the results of subproblems, so we avoid redundant computations.
You call Fib(5, F):

Fib(5) breaks into Fib(4) and Fib(3).
Fib(4) breaks into Fib(3) and Fib(2).
Fib(3) breaks into Fib(2) and Fib(1).
Fib(2) breaks into Fib(1) and Fib(0).
If Fib(1) or Fib(0) is reached, they are returned immediately since they are base cases.


//Fibonacci number (Tabulation / Bottom-up)
if n=5 then in top down we are approaching from f[5] which will lead to f[4] and f[3]  and f[4] will lead to f[3] and f[2] and so on 
and in bottom up our approach will be from f[2] to f[3[ and f[4] and lastly f[5]
#include<iostream>
#include<vector>
using namespace std;
int Fib(int n){
    vector<int> F(n+1); //creating an array F[0...n]
    F[0]=0; //base case
    F[1]=1; //base case
    for(int i=2;i<=n;i++){
        F[i]=F[i-1]+F[i-2]; //at 2, second fibonacci will be be stored, at the third one will be made from the second and first one and the forth one will be made from third and second one,thats how bottom up works
    }
    return F[n];
}
int main(){
    int n;
    cout<<"Enter the value of n:";
    cin>>n;
    int result=Fib(n);
    cout<<"Fibonacci number at position "<<n<<" is: "<<result;
}

//bottom up but this one will have lesser time complexity O(1) whereas the previous ones have O(n)
#include<iostream>
using namespace std;
int Fib(int n){
    if(n==0 || n==1){ //this base case are not necessary to add
        return n;
    }
    int f0=0; 
    int f1=1;
    int f2;
    for(int i=2;i<=n;i++){
        f2=f0+f1; //computing Fib(i)
        f0=f1; //f0 will be the old f1
        f1=f2; //f1 is the new fibonacci number
    }
    return f1;
}
int main(){
    int n;
    cout<<"Enter the value of n:";
    cin>>n;
    int result=Fib(n);
    cout<<"Fibonacci number in positon "<<n<<" is: "<<result;
}


