int coinChange(int M,int d,vector<int>& C){
    vector<int> mnc(M+1, INT_MAX); //creating an array mnc[0..M] and set them all to infinity
    mnc[0]=0; //it takes 0 coins to create the amount 0
    for(int m=1;m<=M;m++){ //from 1 to M (here m is the current target which starts from 1 to main target)
        for(int i=0;i<d;i++){ //how many coin denominations are there that many times it will go
            if(C[i]<=m && mnc[m-C[i]]!=INT_MAX && mnc[m-C[i]]+1<mnc[m]){
                mnc[m]=mnc[m-C[i]]+1;
            }
            //C[i]<=m checks if the current denomination is less than or equal to the current target, if it is greater than m then we cant use it to make the current amount as it will overflow
            //mnc[m-C[i]] checks if there is a valid way to make m-C[i], if it is INT_MAX then it is not possible
            //mnc[m-C[i]]+1<mnc[m] means if i can meake the amount m-C[i] using certain number of coins then adding 1 more coin (C[i]) will make m and if that takes fewer coins to make the amount m,it means we have found the better match
            //mnc[m]=mnc[m-C[i]]+1 this updates the mnc[m] ti be the new minimum coins that will be needed to make the amount m 
        }
    }
    if(mnc[M]==INT_MAX){ //if mnc[M] is still infinity it means then it is not possible to make the amount mnc[M] with the given coin denominations
        return -1;
    }
    return mnc[M]; //return the position of the M in the array which will contain the minimum numbers that will be needed to make the goven amount (as mnc[m] will go from 1 to M)
}
