//Alternative problem 2.2 (minimum cost to create a target length rope)
#include <iostream>
#include <vector>
#include <limits.h>

using namespace std;

int MinCostToMakeRope(int M, vector<int>& C, int X, vector<int>& usedRope) {
    vector<int> dp(M + 1, INT_MAX); //an array which dp[0...M] and all of the position is set to INT_MAX
    
    dp[0] = 0; //base case: as 0 length will take 0 amount of rope

    // Iterate over each length from 1 to M
    for (int m = 1; m <= M; ++m) {
        // Check each rope length in the set C
        for (int i = 0; i < C.size(); ++i) {
            if (m >= C[i] && dp[m - C[i]] != INT_MAX && dp[m] > dp[m - C[i]] + X) {
                    dp[m] = dp[m - C[i]] + X;
                    usedRope[m] = C[i]; // Store the rope length used to get to length m
                }
            }
        }

    return dp[M] == INT_MAX ? -1 : dp[M]; //is dp[M]=INT_MAX, if yes then return -1 else return dp[M]
}

void PrintUsedRopes(int M, vector<int>& usedRope) {
    vector<int> result;

    // Backtrack to find the ropes used
    while (M > 0) {
        result.push_back(usedRope[M]); //we are storing the lengths that were used to make the rope in length
        M -= usedRope[M];
    }

    // Print the used ropes
    cout << "Ropes used to make length: ";
    for (int i = 0; i <result.size(); i++) {
        cout << result[i] << " ";
    }
    cout << endl;
}

int main() {
    int M, d, X;
    cout << "Enter the target length M: ";
    cin >> M;

    cout << "Enter the number of different rope lengths d: ";
    cin >> d;

    vector<int> C(d);
    cout << "Enter the rope lengths: ";
    for (int i = 0; i < d; ++i) {
        cin >> C[i];
    }

    cout << "Enter the cost of joining two ropes X: ";
    cin >> X;

    vector<int> usedRope(M + 1, -1); // Initialize with -1 to indicate no rope used

    int result = MinCostToMakeRope(M, C, X, usedRope);

    if (result != -1) {
        cout << "Minimum cost to make a rope of length " << M << " is: " << result << endl;
        PrintUsedRopes(M, usedRope);
    } else {
        cout << "It is not possible to make a rope of length " << M << " with the given rope lengths" << endl;
    }

    return 0;
}


//Rod Cutting (maximum profit after selling cut of length)
#include<iostream>
#include<vector>
using namespace std;
int rodCutMaxProfit(int n,vector<int> &prices){
    vector<int> rev(n+1,0); //array to store revenue for length i
    vector<int> cuts(n+1,0); //array to store the cuts that made the max rev
    for(int i=1 ; i<=n ; i++){ //iterates every possible rod length from 1 to n
        int maxRev=0;
        for(int j=1; j<=i ; j++){ //for every length i, it will go through every possible cut j from 1 to i
            if(maxRev<prices[j-1]+rev[i-j]){ 
                maxRev=prices[j-1]+rev[i-j];
                cuts[i]=j;
            }
        }
        rev[i]=maxRev;
    }
    //prices[j-1] it checks if the maximum rev can be increased if we take the j cut of length, -1 as prices is 0 indexed, and dp[i-j] the reamaing max rev after cutting off the j cut of length and if their sum (price of j and remaining parts rev of the rod) is greater then make it maxrev and it cuts[i] save the cut of the length that was chosen to make the max rev and also update the rev
    cout<<"Rod cuts for maximum revenue:";
    int length=n;
    while(length>0){
        cout<<cuts[length]<<" ";
        length-=cuts[length];
    }
    cout<<endl;
    
    return rev[n];
}
int main(){
    int n;
    cout<<"Enter the length of the rod: ";
    cin>>n;
    vector<int> prices(n);
    cout<<"Enter price for each length: ";
    for(int i=0;i<n;i++){
        cin>>prices[i];
    }
    int maxRevenue=rodCutMaxProfit(n,prices);
    cout<<"Maximum revenue is : "<<maxRevenue<<endl;
    return 0;
}

    
 //0/1 knapsack
#include<iostream>
#include<vector>
using namespace std;
int knapsack(int W,vector<int> &weights,vector<int> &values,int n){
    vector<vector<int>> dp(n+1,vector<int>(W+1,0));
    //2D vector with dimensions (n+1)x(W+1) n+1 rows and W+1 columns
    for(int i=1; i<=n; i++){ //total number of numbers time it will iterate
        for(int w=0; w<=W; w++){ //iterates through each possible weight capacity w=0 to W
            if(weights[i-1]<=w){ //as weights vector is 0 indexed and i started from 1 thats why we have to -1
                dp[i][w]=max(dp[i-1][w], dp[i-1][w-weights[i-1]]+values[i-1]); //if we include the item
            }
            else{
                dp[i][w]=dp[i-1][w]; //if we exclude the item
            }
        }
    }
    return dp[n][W]; //returing the maximum value which can achieved by filling it with n items with W capacity
    //exclude the item: dp[i][w]=dp[i-1][w] means the if we take the i-th item it will be give the same outcome as the previous one, so that will have no impact thus excluded
    //include the item: dp[i][w] will take the max element between the pevious one and after taking the item, dp[i-1][w] will mean the previous one and dp[i-1][w-weights[i-1] (the remaining items weight as 2D so we can compare through from row and column) + the current items value (values[i-1])
}
void printSelectedItems(int W,vector<int> &weights, vector<int> &values, int n){
    vector<vector<int>> dp(n+1, vector<int>(W+1,0));
    //fill the dp array (same as before)
    for(int i=1;i<=n;i++){
        for(int w=0;w<=W;w++){
            if(weights[i-1]<=w){
                dp[i][w]=max(dp[i-1][w], dp[i-1][w-weights[i-1]]+values[i-1]);
            }
            else{
                dp[i][w]=dp[i-1][w];
            }
        }
    }
    //backtrack to find which items were included
    int w=W;
    cout<<"Selected items are : ";
    for(int i=n; i>0 && w>0; i--){ //as long is there remaining items and capacity left it will iterate
        if(dp[i][w]!=dp[i-1][w]){ //if dp[i][w]==dp[i-1][w] that will mean that taking the item or not does not make any difference as the max value can be achieved without adding the item anyway so that would mean we didnt take the item, so dp[i][w]!=d[i-1][w] will mean it did make a difference so we must have taken the item
            cout<<"(item: "<<i<<", weight: "<<weights[i-1]<<", value: "<<values[i-1]<<")";
            w-=weights[i-1]; //after printing one item remove it as we took it and approach further and print the new ones
        }
    }
    cout<<endl;
}
int main(){
    int n,W;
    cout<<"Enter the number of items:";
    cin>>n;
    cout<<"Enter the maximum capacity:";
    cin>>W;
    vector<int> weights(n);
    vector<int> values(n);
    cout<<"Enter the weights of the items:";
    for(int i=0;i<n;i++){
        cin>>weights[i];
    }
    cout<<"Enter the values of the items:";
    for(int i=0;i<n;i++){
        cin>>values[i];
    }
    int maxValue=knapsack(W,weights,values,n);
    cout<<"Maximum value on knapsack ="<<maxValue<<endl;
    printSelectedItems(W,weights,values,n);
    return 0;
}

   
//Subset sum problem
#include<iostream>
#include<vector>
using namespace std;
vector<vector<bool>> findSubsets(vector<int> elements, int T){
    int n=elements.size();
    vector<vector<bool>> dp(n+1, vector<bool>(T+1,false)); //creating a 2D array where all index is set to false
    for(int i=0;i<=n;i++){ 
        dp[i][0]=true; //base case: target 0 is always possible to achieve
    }
    for(int i=1;i<=n;i++){
        for(int sum=1;sum<=T;sum++){
            if(sum>=elements[i-1]){ //if the element is equal or lesser than the sum then it can be included and as elements is 0 indexed so we use i-1
                dp[i][sum]=dp[i-1][sum] || dp[i-1][sum-elements[i-1]]; //dp[i-1][sum] means we can achieve the sum without including it and the or one means can we achieve the rest of the sum wihtout using the current element, if so that would mean we can achieve the target with adding the element
            }
            else{
            dp[i][sum]=dp[i-1][sum]; //we are not including the element if it is bigger than sum
            }
        }
    }
    return dp; //return dp after its true and false map,by which we can detect which elements were chosen to make the target
}
void printSubsets(int n,int T,vector<int> elements,vector<vector<bool>> dp,vector<int> currentSubset){
    if(T==0){ //if the target is 0 that would mean we have achieved the goal so start printing it
        cout<<"{ ";
        for(int num:currentSubset){
            cout<<num<<" ";
        }
        cout<<"}"<<endl;
        return; //we have to return after done with the printing otherwise it will keep printing
    }
    if(n==0) return; //after going through and reducing n-1 when it will come to 0 then return to avoid an infinite loop
    if(dp[n-1][T]){ //if it is true that would mean we can achieve the sum without taking the current element so skip it
        printSubsets(n-1,T,elements,dp,currentSubset); //call the function again with the remaining elements
    }
    if(T>=elements[n-1] && dp[n-1][T-elements[n-1]]){ //if we include the element
        currentSubset.push_back(elements[n-1]); //currentSubset is the vector which will have the elements that will build the target so push that element to it
        printSubsets(n-1,T-elements[n-1],elements,dp,currentSubset); //call the print function again to go through the remianing elements
        currentSubset.pop_back(); //that would deduce the element we already took 
    }
}
int main(){
    int n,T;
    cout<<"Enter the value:";
    cin>>n;
    vector<int> elements(n);
    cout<<"Enter the elements:";
    for(int i=0; i<n; i++){
        cin>>elements[i];
    }
    cout<<"Enter the target:";
    cin>>T;
    vector<vector<bool>> dp=findSubsets(elements,T);
    if(!dp[n][T]){ //if after going through all elements the target index still remains false then it is impossible to achieve
        cout<<"The target "<<T<<" cant be achieved by the given elements";
    }
    else{
        vector<int> currentSubset;
        printSubsets(n,T,elements,dp,currentSubset);
    }
}


//longest common subsequence
#include<iostream>
#include<vector>
using namespace std;
pair<int,string> lcs(string x,string y){
    int m=x.size();
    int n=y.size();
    vector<vector<int>> dp(m+1, vector<int>(n+1,0)); //we are creating a 2d array
    for(int i=1;i<=m;i++){ //we started it from 1 as we need another row and column in dp for length 0
        for(int j=1;j<=n;j++){
            if(x[i-1]==y[j-1]){ //if mathces and -1 as array is indexed to 0
                dp[i][j]=dp[i-1][j-1]+1; //adding +1(as matched) to the previous substring (diagonally)
            }
            else{
                dp[i][j]=max(dp[i][j-1],dp[i-1][j]); //if does not match we either skip the current character x or y and continue with the max lcs length found so far
            }
        }
    }
    int lcs_length=dp[m][n]; //it means we have crossed both of the strings and have stored the largest lcs length
    string lcs=" "; //to backtrack the string
    int i=m,j=n; //i and j has the strings length
    while(i>0 && j>0){ //and it will continue till the end as we are backtracking so from m to 0
        if(x[i-1]==y[j-1]){ //if mathces
            lcs=x[i-1]+lcs; //add either x or y's letter as the same to the lcs string
            i--; //then decrease the size of both of the to go diagonally
            j--;
        }
        else if(dp[i-1][j]>dp[i][j-1]){ //if does not match go either up or left (whichever one is the max one)
            i--; //if up is max then go up
        } 
        else{
            j--; //if left is max then go left
        }
    }
    return {lcs_length,lcs}; //as it is a pair so {}
}
int main(){
    string x,y;
    cout<<"Enter the first string:";
    cin>>x;
    cout<<"Enter the second string:";
    cin>>y;
    auto result=lcs(x,y); //here auto means it will automatically get the return type without having to assign it manually (like here it will receive a pair of int and string)
    cout<<"Longest common subsequence length:"<<result.first<<endl;
    cout<<"Logest common subsequence:"<<result.second;
}




//Shortest Common Supersequence Problem
#include <iostream>
#include <string>
using namespace std;
 
int SCSLength(string X, string Y, int m, int n)
{
    //if one of the strings is empty,the SCS is just the other string.so,if m == 0, return n (length of string Y), and if n == 0, return m (length of string X).
    if (m == 0 || n == 0) {
        return n + m;
    }
  //if the last characters of both strings match,we remove the last character from both strings and solve for the remaining strings,the result is then incremented by 1 (since we are adding this character to the supersequence)
    if (X[m - 1] == Y[n - 1]) {
        return SCSLength(X, Y, m - 1, n - 1) + 1;
    }
    
    else {
        return min(SCSLength(X, Y, m, n - 1) + 1,
                    SCSLength(X, Y, m - 1, n) + 1);
    }
    /*if the last characters don't match, we have two options:remove the last character of Y and solve for X[1...m] and Y[1...n-1], or remove the last character of X and solve for X[1...m-1] and Y[1...n].we take the minimum of these two and add 1, representing the addition of one new character to the supersequence. */
}
 
int main()
{
    string X,Y;
    cout<<"Enter the first string:";
    cin>>X;
    cout<<"Enter the second string:";
    cin>>Y;
    int m = X.length(), n = Y.length();
 
    cout << "The length of the shortest common supersequence is "
         << SCSLength(X, Y, m, n);
 
    return 0;
}


//Longest increasing subsequence
#include <iostream>
#include <vector>
using namespace std;

int LIS_DP(int arr[], int n) {
    // Create a DP array to store the length of LIS with all its elements assigned to 1
    vector<int> dp(n, 1);

    // Iterate over each element
    for (int i = 1; i < n; i++) {
        // Check all previous elements
        for (int j = 0; j < i; j++) {
            // If the current element is greater than the previous one and it forms a longer increasing subsequence, by adding 1 (dp[j] + 1),we are counting the new element arr[i] as an extension of the subsequence that ends at arr[j].
            if (arr[i] > arr[j]) {
                dp[i] = max(dp[i], dp[j] + 1);
            }
        }
    }

    // Find the maximum value in the DP array, which is the length of the LIS
    int maxLength = 0;
    for (int i = 0; i < n; i++) {
        maxLength = max(maxLength, dp[i]);
    }

    return maxLength;
}

int main() {
    int n;
   cout<<"How many numbers will the array have:";
   cin>>n;
   int arr[n];
   cout<<"Enter the numbers:";
   for(int i=0;i<n;i++){
       cin>>arr[i];
   }
    cout << "The length of the LIS is " << LIS_DP(arr, n) << endl;

    return 0;
} 


//The Levenshtein distance (Edit distance) Problem
#include <iostream>
using namespace std;
 
// Function to find Levenshtein distance between string `X` and `Y`.
int dist(string X, string Y)
{
    int m = X.length();
    int n = Y.length();
 
    // For all pairs of `i` and `j`, `T[i, j]` will hold the Levenshtein distance
    int T[m + 1][n + 1];
 
    // We can transform source prefixes into an empty string by dropping all characters 
    for (int i = 0; i <= m; i++) {
        T[i][0] = i;  // Fill first column (deletion case)
        //First Column: Represents the number of deletions needed to transform prefixes of string X into an empty string. handles the special case where we're converting any prefix of X into an empty string (via deletions)
    }
 
    // We can reach target prefixes from empty source prefix by inserting every character
    for (int j = 0; j <= n; j++) {
        T[0][j] = j;  // Fill first row (insertion case)
        //First Row: Represents the number of insertions needed to transform an empty string into prefixes of string Y
    }
 
    int substitutionCost;
 
    // Fill the lookup table in a bottom-up manner
    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {
            if (X[i - 1] == Y[j - 1]) {
                substitutionCost = 0;  // No cost if characters match
            } else {
                substitutionCost = 1;  // Cost of substitution if they differ
            }

            // Calculate the minimum cost from deletion, insertion, and substitution
            T[i][j] = min(min(T[i - 1][j] + 1,          // deletion
                              T[i][j - 1] + 1),         // insertion
                          T[i - 1][j - 1] + substitutionCost);  // substitution
        }
        //deletion : "What was the cost to convert the first i−1 characters of X to the first j characters of Y?" Plus one more for the deletion
        
       //insertion : What was the cost to convert the first i characters of X to the first j−1 characters of Y? Plus one more for the insertion
      
      //What was the cost to convert the first i−1 characters of X to the first j−1 characters of Y?" Plus the cost of substituting the last character 
    }
 
    return T[m][n];
}
 
