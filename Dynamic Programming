//Alternative problem 2.2 (minimum cost to create a target length rope)
#include <iostream>
#include <vector>
#include <limits.h>

using namespace std;

int MinCostToMakeRope(int M, vector<int>& C, int X, vector<int>& usedRope) {
    vector<int> dp(M + 1, INT_MAX); //an array which dp[0...M] and all of the position is set to INT_MAX
    
    dp[0] = 0; //base case: as 0 length will take 0 amount of rope

    // Iterate over each length from 1 to M
    for (int m = 1; m <= M; ++m) {
        // Check each rope length in the set C
        for (int i = 0; i < C.size(); ++i) {
            if (m >= C[i] && dp[m - C[i]] != INT_MAX && dp[m] > dp[m - C[i]] + X) {
                    dp[m] = dp[m - C[i]] + X;
                    usedRope[m] = C[i]; // Store the rope length used to get to length m
                }
            }
        }

    return dp[M] == INT_MAX ? -1 : dp[M]; //is dp[M]=INT_MAX, if yes then return -1 else return dp[M]
}

void PrintUsedRopes(int M, vector<int>& usedRope) {
    vector<int> result;

    // Backtrack to find the ropes used
    while (M > 0) {
        result.push_back(usedRope[M]); //we are storing the lengths that were used to make the rope in length
        M -= usedRope[M];
    }

    // Print the used ropes
    cout << "Ropes used to make length: ";
    for (int i = 0; i <result.size(); i++) {
        cout << result[i] << " ";
    }
    cout << endl;
}

int main() {
    int M, d, X;
    cout << "Enter the target length M: ";
    cin >> M;

    cout << "Enter the number of different rope lengths d: ";
    cin >> d;

    vector<int> C(d);
    cout << "Enter the rope lengths: ";
    for (int i = 0; i < d; ++i) {
        cin >> C[i];
    }

    cout << "Enter the cost of joining two ropes X: ";
    cin >> X;

    vector<int> usedRope(M + 1, -1); // Initialize with -1 to indicate no rope used

    int result = MinCostToMakeRope(M, C, X, usedRope);

    if (result != -1) {
        cout << "Minimum cost to make a rope of length " << M << " is: " << result << endl;
        PrintUsedRopes(M, usedRope);
    } else {
        cout << "It is not possible to make a rope of length " << M << " with the given rope lengths" << endl;
    }

    return 0;
}


//Rod Cutting (maximum profit after selling cut of length)
#include<iostream>
#include<vector>
using namespace std;
int rodCutMaxProfit(int n,vector<int> &prices){
    vector<int> rev(n+1,0); //array to store revenue for length i
    vector<int> cuts(n+1,0); //array to store the cuts that made the max rev
    for(int i=1 ; i<=n ; i++){ //iterates every possible rod length from 1 to n
        int maxRev=0;
        for(int j=1; j<=i ; j++){ //for every length i, it will go through every possible cut j from 1 to i
            if(maxRev<prices[j-1]+rev[i-j]){ 
                maxRev=prices[j-1]+rev[i-j];
                cuts[i]=j;
            }
        }
        rev[i]=maxRev;
    }
    //prices[j-1] it checks if the maximum rev can be increased if we take the j cut of length, -1 as prices is 0 indexed, and dp[i-j] the reamaing max rev after cutting off the j cut of length and if their sum (price of j and remaining parts rev of the rod) is greater then make it maxrev and it cuts[i] save the cut of the length that was chosen to make the max rev and also update the rev
    cout<<"Rod cuts for maximum revenue:";
    int length=n;
    while(length>0){
        cout<<cuts[length]<<" ";
        length-=cuts[length];
    }
    cout<<endl;
    
    return rev[n];
}
int main(){
    int n;
    cout<<"Enter the length of the rod: ";
    cin>>n;
    vector<int> prices(n);
    cout<<"Enter price for each length: ";
    for(int i=0;i<n;i++){
        cin>>prices[i];
    }
    int maxRevenue=rodCutMaxProfit(n,prices);
    cout<<"Maximum revenue is : "<<maxRevenue<<endl;
    return 0;
}

    
    

   
